# Local datasets and staged data roots
# NOTE: several of these are symlinks (-> /workspace/asr/Palestinian-ASR/...), and git's
# trailing-slash "matches directories only" rule does NOT match symlinks even when they point
# to a directory - so these are listed WITHOUT a trailing slash to also catch the symlink itself.
data
data_*
processed_qasr_segments
omnilingual_selected
casablanca
Layla
QASR
MASC-Arabic2
segments

# Common model and training artifact directories
# outputs/
comparison/
**/weights/
**/weight/
**/best_model/
**/best_checkpoint/
**/predictions.jsonl
**/row_probabilities.jsonl

